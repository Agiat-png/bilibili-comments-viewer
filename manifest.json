{
  "manifest_version": 3,
  "name": "Bilibili Guest Comment Viewer",
  "version": "1.0",
  "description": "未ログイン状態でもBilibiliのコメントを取得して画面上に独自表示します。",
  "permissions": [],
  "host_permissions": [
    "*://*.bilibili.com/*",
    "*://api.bilibili.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.bilibili.com/video/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}
